  "profiles": [
    {
      "id": "git-repository",
      "applies_to": "Canonical Git projects with a repository root at the registered project home.",
      "baseline": ["README.md or project entry", "docs/ when durable project documentation exists", "_gitignore/README.md and manifest.yml when visible local-artifact inventory is needed", ".worktrees/<task> for active Git worktrees"],
      "extension_policy": "Project-specific src, app, data, assets, scripts, tests, or system-workflow directories are allowed when documented by the project contract.",
      "local_artifact_policy": ".gitignore is enforcement; _gitignore/ is the tracked human-readable manifest and must not contain secrets or replace tool-required native locations."
    },
    {
      "id": "morrowise-control-plane",
      "applies_to": "Canonical control-plane repositories such as harness-mc.",
      "baseline": ["milestones/", "system-workflow/registries/", "system-workflow/schemas/", "system-workflow/docs/", "scripts/", "public/data/ generated-only"],
      "extension_policy": "New control-plane capability requires task anchor, source boundary, verifier, and generated/read-model boundary before promotion.",
      "local_artifact_policy": "Use the git-repository local-artifact policy and keep generated data outside canonical task or registry state."
    },
    {
      "id": "agent-control-plane",
      "applies_to": "Canonical shared agent repositories such as notyet-harness.",
      "baseline": ["000_Agent/", "000_Agent/docs/agent-control-plane/", "000_Agent/decisions/", "000_Agent/skills/", "000_Agent/memory/"],
      "extension_policy": "Stable contracts and ADRs live in their named folders; historical material remains separately labelled and is not current state.",
      "local_artifact_policy": "Use the git-repository local-artifact policy and keep local agent runtime outside shared source-of-truth paths."
    },
    {
      "id": "non-git-project",
      "applies_to": "Intentional local projects that do not yet use Git.",
      "baseline": ["README.md or project entry", "docs/ or assets/ when applicable", "_gitignore/ manifest if local artifacts require visibility"],
      "extension_policy": "May add a type-specific layout; must either adopt Git or record why it remains a non-Git canonical project.",
      "local_artifact_policy": "If a tool generates local artifacts, maintain an explicit manifest; do not invent a fake .gitignore without a Git repository."
    },
    {
      "id": "legacy-root-worktree",
      "applies_to": "Git worktrees that currently sit beside their canonical project at $COLLAB root.",
      "baseline": ["registered Git worktree", "project_home_ref", "repo_ref", "current Git preflight evidence"],
      "extension_policy": "This is a migration-only profile: no new worktree may use it. Move only through an approved record and Git worktree move, or remove only after safe closeout.",
      "local_artifact_policy": "Do not add project content or local manifests here; the destination profile is the canonical project's .worktrees/<task> convention."
    },
    {
      "id": "runtime-local",
      "applies_to": "Tool runtime, cache, temporary, or local session directories.",
      "baseline": ["tool-owned runtime layout only"],
      "extension_policy": "Do not place canonical project data here; promote durable material into its registered project home.",
      "local_artifact_policy": "Runtime directories are exempt from project migration and must not be inspected for secrets during inventory."
    },
    {
      "id": "historical-archive",
      "applies_to": "Historical or migration-package material retained for reference.",
      "baseline": ["archive descriptor or README when practical"],
      "extension_policy": "Extract reusable patterns into an active canonical location; do not use archive state as current source of truth.",
      "local_artifact_policy": "Archive content is exempt from topology migration unless Vincent approves a restoration or retirement record."
    }
  ],
