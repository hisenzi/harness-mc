{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrowise.local/schemas/document-source.schema.json",
  "title": "MorroWise document source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_version", "registry_ref", "reviewed_at", "source_allowlist", "public_allowlist", "records", "human_navigation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope_version": {"enum": ["first-chapter-local-v1", "manual-local-v2"]},
    "registry_ref": {"type": "string", "pattern": "^\\$COLLAB/"},
    "reviewed_at": {"$ref": "#/$defs/date"},
    "source_allowlist": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
    "public_allowlist": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "human_navigation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/navigation"}},
    "capability_mappings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "impact_reviews": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "allOf": [{
    "if": {"properties": {"scope_version": {"const": "manual-local-v2"}}},
    "then": {
      "properties": {
        "source_allowlist": {"maxItems": 1},
        "records": {"minItems": 6, "maxItems": 6, "items": {"required": ["chapter_id", "document_version"], "properties": {"document_role": {"const": "human_guide"}}}},
        "human_navigation": {"minItems": 12, "maxItems": 12, "items": {
          "if": {"properties": {"kind": {"const": "content"}}},
          "then": {"required": ["record_id"], "not": {"required": ["record_ids"]}},
          "else": {"required": ["record_ids"], "not": {"required": ["record_id"]}}
        }}
      }
    },
    "else": {"properties": {
      "records": {"items": {"properties": {"status": {"const": "active"}}}},
      "human_navigation": {"items": {"required": ["record_id"], "not": {"required": ["record_ids"]}}}
    }}
  }],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sourceRef": {"type": "string", "pattern": "^\\$COLLAB/(?!.*(?:^|/)(?:\\.env|secrets?|credentials?|tokens?|runtime-auth|auth)(?:\\.|/|$))[A-Za-z0-9_./-]+$"},
    "relation": {"type": "string", "enum": ["canonical", "derived_from", "detail", "evidence"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "relation", "fingerprint"],
      "properties": {"path": {"$ref": "#/$defs/sourceRef"}, "relation": {"$ref": "#/$defs/relation"}, "fingerprint": {"$ref": "#/$defs/hash"}}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "record_kind", "system_id", "title", "architecture_layer", "document_role", "audience", "status", "visibility", "source_refs", "member_globs", "generated_targets", "owner", "task_anchor", "write_policy", "verifiers", "fingerprint_policy", "fingerprint_fields", "summary_impact", "architecture_summary", "human_summary", "human_content_ref", "summary_reviewed_source_fingerprint", "summary_reviewed_at", "summary_reviewed_by", "last_verified_at", "supersedes", "superseded_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "record_kind": {"const": "document"}, "system_id": {"const": "morrowise"}, "title": {"type": "string", "minLength": 1},
        "architecture_layer": {"type": "string", "enum": ["entry", "rules", "capabilities", "runtime", "governance"]},
        "document_role": {"type": "string", "enum": ["canonical", "protocol", "schema", "detail", "runbook", "evidence", "generated", "mirror", "human_guide"]},
        "audience": {"const": "both"}, "status": {"enum": ["active", "conditional"]}, "visibility": {"const": "local_only"},
        "chapter_id": {"enum": ["entry", "collaboration", "execution", "delivery", "documentation", "troubleshooting"]},
        "document_version": {"type": "string", "pattern": "^v(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/source"}},
        "member_globs": {"type": "array", "maxItems": 0, "items": {"type": "string"}}, "generated_targets": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "owner": {"type": "string", "minLength": 1}, "task_anchor": {"type": "string", "minLength": 1}, "write_policy": {"const": "manual"},
        "verifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fingerprint_policy": {"const": "full_content"}, "fingerprint_fields": {"type": "array", "maxItems": 0, "items": {"type": "string"}}, "summary_impact": {"const": "human"}, "architecture_summary": {"type": "string", "minLength": 1},
        "human_summary": {"type": "string", "minLength": 1}, "human_content_ref": {"$ref": "#/$defs/sourceRef"}, "summary_reviewed_source_fingerprint": {"$ref": "#/$defs/hash"}, "summary_reviewed_at": {"$ref": "#/$defs/date"}, "summary_reviewed_by": {"type": "string", "minLength": 1}, "last_verified_at": {"$ref": "#/$defs/date"},
        "supersedes": {"type": "array", "maxItems": 0, "items": {"type": "string"}}, "superseded_by": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "kind"],
      "properties": {"id": {"type": "string", "minLength": 1}, "slug": {"type": "string", "pattern": "^(?:[a-z0-9-]+(?:/[a-z0-9-]+)*)?$"}, "title": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["home", "index", "content"]}, "record_id": {"type": "string", "minLength": 1}, "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    }
  }
}
