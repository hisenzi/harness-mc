{
  "name": "harness-mc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "sync": "node scripts/sync-notion-courses.mjs",
    "sync:obsidian-canvas": "node scripts/generate-data.mjs && node scripts/sync-obsidian-canvas.mjs --whiteboard \"MC 儀表版\"",
    "test:task-event-outbox": "node scripts/verify-task-event-outbox.mjs",
    "test:apply-task-events": "node scripts/verify-apply-task-events.mjs",
    "test:task-state": "node scripts/verify-task-state-merge.mjs",
    "test:sync-event-queue": "node scripts/verify-sync-event-queue.mjs",
    "test:task-event-dashboard": "node scripts/verify-task-event-dashboard-data.mjs",
    "test:skills": "node scripts/verify-validate-skills.mjs && node scripts/validate-skills.mjs --changed-only",
    "test:tasks": "node scripts/verify-validate-tasks.mjs && node scripts/validate-tasks.mjs --changed-only --project harness-mc",
    "test:work-anchor-preflight": "node scripts/verify-work-anchor-preflight.mjs",
    "test:required-publish-flow": "node scripts/verify-required-publish-flow.mjs",
    "test:morrowise-schema": "node scripts/verify-morrowise-system-schema.mjs",
    "test:morrowise-console": "node scripts/verify-morrowise-control-console.mjs",
    "test:morrowise-triggers": "node scripts/verify-morrowise-trigger-rules.mjs",
    "test:morrowise-recommendations": "node scripts/verify-morrowise-recommendations.mjs",
    "test:morrowise-approval": "node scripts/verify-morrowise-approval-policy.mjs",
    "test:morrowise-runner": "node scripts/verify-morrowise-action-runner.mjs",
    "test:morrowise-loop": "node scripts/verify-morrowise-proactive-loop.mjs",
    "test:morrowise-live-dashboard": "node scripts/verify-morrowise-live-dashboard-data.mjs",
    "test:morrowise-live-loop": "node scripts/verify-morrowise-live-dashboard-loop.mjs",
    "test:worktree-status": "node scripts/generate-worktree-status.mjs",
    "prebuild": "node scripts/check-adr-backlinks.mjs && node scripts/validate-skills.mjs --changed-only && node scripts/generate-data.mjs && node scripts/generate-tools-data.mjs && node scripts/generate-task-event-data.mjs && node scripts/generate-morrowise-proactive-loop.mjs && node scripts/generate-worktree-status.mjs && node scripts/sentinel-diff.mjs && node scripts/generate-morrowise-live-dashboard.mjs",
    "build": "next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "postcss": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
