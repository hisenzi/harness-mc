{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morrowise.milestone-group.v1",
  "title": "MorroWise milestone group marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "layout", "max_project_depth"],
  "properties": {
    "schema_version": { "const": "morrowise.milestone-group.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "layout": { "const": "grouped-yymmdd-project-v1" },
    "max_project_depth": { "const": 1 }
  }
}
