{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morrowise-workbook.v1",
  "title": "MorroWise development workbook v1",
  "description": "Structural validation only. Trusted source, filesystem, exact IDs, lifecycle and verifier execution are checked by workbook-anchor runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "order_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
        }
      },
      "required": [
        "repo_id",
        "path"
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repo_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_root": {
            "type": "string",
            "minLength": 1
          },
          "checkout_root": {
            "type": "string",
            "minLength": 1
          },
          "write_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
            },
            "minItems": 1
          },
          "control_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
            }
          }
        },
        "required": [
          "repo_id",
          "canonical_root",
          "checkout_root",
          "write_paths"
        ]
      },
      "minItems": 1
    },
    "baseline_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "digest"
        ]
      },
      "minItems": 1
    },
    "canonical_baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "task_digest": {
              "type": "string",
              "minLength": 1
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "task_ref",
            "task_digest",
            "acceptance"
          ]
        }
      ]
    },
    "done_condition": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repo_id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executable_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
          },
          "entrypoint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
            },
            "minItems": 1
          },
          "artifact_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))[^\\\\\\u0000]+$"
            },
            "minItems": 1
          },
          "requirement_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "repo_id",
          "command",
          "args",
          "executable_sha256",
          "entrypoint",
          "entrypoint_sha256",
          "source_paths",
          "artifact_paths"
        ]
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "digest"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_wall_time_ms",
        "max_attempts"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "enum": [
          "implement",
          "verify",
          "commit",
          "handoff",
          "integrate"
        ]
      },
      "minItems": 1
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "stop_resume": {
      "type": "string",
      "minLength": 1
    },
    "formal_target": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "contract_revision",
    "project_id",
    "task_id",
    "title",
    "order_label",
    "home",
    "repos",
    "baseline_refs",
    "canonical_baseline",
    "done_condition",
    "acceptance",
    "dependencies",
    "budget",
    "allowed_actions",
    "approval_refs",
    "stop_resume",
    "formal_target"
  ]
}
